# Sanity CMS — required
# Get these from sanity.io → your project → API
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_WRITE_TOKEN=your_write_scoped_token
# Viewer-scoped token for server-side reads. Required once the dataset is set
# to Private (sanity.io → project → API → Datasets), which it should be.
SANITY_READ_TOKEN=your_viewer_scoped_token

# Auth gates — required
# FAMILY_PASSCODE: shared code Coach gives to families (unlocks /videos, /gallery)
# ADMIN_PASSWORD: coach-only password for /admin panel
# THE_ONE: separate password for /neo project tracker (keep this one secret)
FAMILY_PASSCODE=choose_a_passcode
ADMIN_PASSWORD=choose_a_password
THE_ONE=choose_a_password

# Session signing secrets — REQUIRED (there is no fallback; logins are
# disabled if these are missing). Generate each with: openssl rand -hex 32
ADMIN_SESSION_SECRET=generate_with_openssl_rand_hex_32
PARENT_SESSION_SECRET=generate_with_openssl_rand_hex_32

# Vercel cron auth — REQUIRED for /api/cron/game-day-reminder
CRON_SECRET=generate_with_openssl_rand_hex_32

# QStash — REQUIRED for game-day push + result checker
# Signing keys: console.upstash.com → QStash → Signing Keys. Requests to
# /api/cron/game-day-push and /api/cron/result-checker are rejected without them.
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=sig_your_current_key
QSTASH_NEXT_SIGNING_KEY=sig_your_next_key

# Rate limiting — optional (app works without these; API routes won't be rate-limited)
# Get from console.upstash.com → your Redis database → REST API tab
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token

# GitHub Issues — optional (enables creating issues from the roadmap feedback form)
# Create a fine-grained token at github.com/settings/tokens with Issues: Read & write
# on the ErickZBrambila/legends-pitch repository
GITHUB_ISSUES_TOKEN=github_pat_your_token

# Claude AI — required for announcements auto-translation and match article generation
# Get from console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Coach API token — optional (for future external clients: Discord bot, WhatsApp, etc.)
# Generate any strong random string: openssl rand -hex 32
COACH_API_TOKEN=your_random_token_here

# Feature flags — optional
# Set to "true" to enable the coach onboarding route (/api/onboarding)
# Leave unset (or "false") to keep it disabled — activate on demand, then disable when done
ONBOARDING_ENABLED=false
